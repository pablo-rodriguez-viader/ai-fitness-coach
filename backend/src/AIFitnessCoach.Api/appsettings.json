{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "Jwt": {
    "Issuer": "https://api.aifitnesscoach.example",
    "Audience": "aifitnesscoach-mobile",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Apple": {
    "Audience": "",
    "TeamId": "",
    "KeyId": "",
    "PrivateKey": ""
  },
  "RateLimiting": {
    "RequestsPerMinute": 300,
    "AuthRequestsPerMinute": 30,
    "TelemetryRequestsPerMinute": 20,
    "SupportRequestsPerMinute": 5,
    "AccountRequestsPerMinute": 5
  },
  "Release": {
    "Environment": "beta",
    "MinimumSupportedBuild": 0,
    "SupportEmail": "",
    "PrivacyPolicyUrl": "",
    "TermsUrl": ""
  },
  "FeatureFlags": {
    "coach": true,
    "activity_analysis": true,
    "workouts": true,
    "nutrition": true,
    "goals": true,
    "progress": true,
    "engagement": true,
    "feedback_center": true,
    "data_export": true,
    "beta_feedback": true
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "",
    "Protocol": "grpc",
    "ServiceName": "aifitnesscoach-api",
    "TraceSampleRatio": 0.2
  },
  "ForwardedHeaders": {
    "Enabled": false
  },
  "Analytics": {
    "AdminApiKey": ""
  },
  "AllowedHosts": "*"
}
