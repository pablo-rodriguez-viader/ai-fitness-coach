# Copy to .env (git-ignored) and fill in. Used by `docker compose up -d`.
# Generate random values in PowerShell:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))

POSTGRES_PASSWORD=
JWT_SIGNING_KEY_BASE64=

# Must be exactly the bundle id you register in Apple Developer (e.g. com.pablo.aicoach).
APPLE_AUDIENCE=

# Personal use: only one account can be created through the public URL.
BETA_MAX_USERS=1

# Free install (Sideloadly, no Sign in with Apple): your secret login code, 24+ characters.
# Generate it like the passwords above. Leave empty when using Sign in with Apple only.
PERSONAL_ACCESS_CODE=
RELEASE_ENVIRONMENT=beta

# AI (optional). Without it, Coach, Analysis and workout plans are hidden in the app.
AI_ENABLED=false
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
# USD per million tokens of the chosen model (check current OpenAI pricing). Must be > 0 when AI_ENABLED=true.
AI_INPUT_COST_PER_MILLION_TOKENS=0
AI_OUTPUT_COST_PER_MILLION_TOKENS=0

# Optional: product report and support inbox (32+ characters).
ANALYTICS_ADMIN_API_KEY=

# Optional: revoke Sign in with Apple when deleting the account (Apple Developer › Keys).
APPLE_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY=
